PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/reelo
JWT_SECRET=replace_this_with_a_secure_secret
JWT_EXPIRES_IN=7d
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_gmail_address@gmail.com
# Set to true only if your SMTP provider requires STARTTLS (not port 465).
SMTP_REQUIRE_TLS=false
# Prevent an unavailable SMTP host from hanging an OTP request indefinitely.
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
